   "source": [
    "import torch\n",
    "import torch.nn as nn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c12406b4-f055-4273-859b-d90d484c2447",
   "metadata": {},
   "outputs": [],
   "source": [
    "w = torch.tensor(3.0, requires_grad=True)\n",
    "x = torch.tensor(2.0)\n",
    "y_true = torch.tensor(5.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "2668a3d8-f5fb-4c65-8d4d-c8f3fe7573a1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 st backward 28.0\n"
     ]
    }
   ],
   "source": [
    "y_pred = w * x\n",
    "loss1 = (y_pred - y_true)**2\n",
    "loss1.backward()\n",
    "print(\"1 st backward\",w.grad.item())\n"
   ]
  },
